{
  "name": "uni-switch",
  "version": "0.5.29",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "build:go": "node scripts/build-go.mjs",
    "test:go": "node scripts/test-go.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "tauri": "tauri",
    "docs:check": "node scripts/check-upstream-source.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.19.0",
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "prettier": "3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/dieqiyun/uni-switch.git"
  }
}
